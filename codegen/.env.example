# ===== OpenAPI Code Generation Environment Variables =====
# Copy this file to .env and adjust for your environment.
#
# SWAGGER_URL: The full URL to the Swagger/OpenAPI JSON spec.
#   The backend groups specs by module. For App Store:
#   - Local:      http://localhost:5000/swagger/Apps/swagger.json
#   - Dev:        https://dev_ihsc-connectapi.apprx.eu/swagger/Apps/swagger.json
#   - Staging:    https://staging-api.apprx.eu/swagger/Apps/swagger.json
#
# If not set, defaults to the local URL.

SWAGGER_URL=http://localhost:5000/swagger/Apps/swagger.json
